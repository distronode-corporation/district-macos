<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The entitlements an AD-HOC build (CI, a local test run) is signed with, passed as
  `CODE_SIGN_ENTITLEMENTS=App/AdHoc.entitlements` on the xcodebuild command line.

  ⛔ ONLY THE `com.apple.security.*` KEYS FROM project.yml, AND NOT THE RESTRICTED ONES.
  Push, Sign in with Apple, associated domains and the keychain access group must be
  granted by a provisioning profile; an ad-hoc signature carrying them is refused by
  macOS at launch ("Launchd job spawn failed", RunningBoard error 5), so the test host
  could never start. The sandbox and the device keys need no profile, so the tests run
  under the same sandbox the shipped app does.

  ⚠️ NOT GENERATED AND NOT REFERENCED BY project.yml, which writes the two real files
  (App/DistrictMac.entitlements, App/DistrictMacDirect.entitlements). Keep these keys
  in step with the template's `com.apple.security.*` keys by hand.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
